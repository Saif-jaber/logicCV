{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "LogicCV Resume Data",
  "required": [
    "name",
    "title",
    "email",
    "phone",
    "location",
    "summary",
    "experience",
    "education",
    "skills",
    "projects"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "title": { "type": "string" },
    "email": { "type": "string" },
    "phone": { "type": "string" },
    "location": { "type": "string" },
    "summary": { "type": "string" },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "company", "period", "bullets"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "company": { "type": "string" },
          "location": { "type": "string" },
          "period": { "type": "string" },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "bullets"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "bullets": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "degree", "school", "period"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "degree": { "type": "string" },
          "school": { "type": "string" },
          "location": { "type": "string" },
          "period": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "customSections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "fontFamily": {
      "type": "string",
      "enum": ["serif", "sans", "mono"],
      "default": "serif"
    },
    "additional": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "items"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
